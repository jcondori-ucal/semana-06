# Copia este archivo como .env y completa los valores.
# .env NUNCA se sube a GitHub (está en .gitignore)

# --- API ---
PORT=3000

# --- Conexión a MySQL (la usa Node.js) ---
# Con Docker Compose el host es el NOMBRE DEL SERVICIO: db
# Si corres Node fuera de Docker usa: localhost
DB_HOST=db
DB_PORT=3306
DB_NAME=tienda_ucal
DB_USER=app_user
DB_PASSWORD=cambia_esta_clave

# --- Solo para el contenedor de MySQL ---
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
